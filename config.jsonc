// ╔═════════════════════════════════════════════════════════════╗
// ║  НАСТРОЙКИ САЙТА                                            ║
// ║  Файл читается как JSON, но в нём можно писать комментарии  ║
// ║  (// …) и оставлять запятую после последнего пункта.        ║
// ║  Любую функцию из части Б можно выключить: "enabled": false ║
// ╚═════════════════════════════════════════════════════════════╝
{

// ╔═════════════════ ЧАСТЬ А. ДАННЫЕ ═════════════════╗

// ═══════════════════════════════════════════════════════════════
// 1. ОСНОВНОЕ — ссылки и общие тексты
// ═══════════════════════════════════════════════════════════════
"main": {
  // Кнопка «Написать» в левом верхнем углу
  "contact": "https://t.me/your_username",
  // Кнопка «Поддержать» в правом верхнем углу
  "donate": "https://example.com/donate",
  // Ссылка-подписка (универсальный формат). Используется, если выключен раздел «Несколько подписок»
  "allUrl": "https://example.com/sub/all",
  // Та же подписка в формате Clash (.yaml)
  "allClashUrl": "https://example.com/sub/all.yaml",
  // Число конфигов, которое показывается в плитке «конфигов в подписке»
  "configCount": 158,
  // Время последнего обновления, например "2026-11-07T17:00:00Z".
  // Пусто — берётся время изменения этого файла на сервере.
  "updatedAt": "",
  // Текст внизу страницы. Пусто — подвал скрыт.
  "footer": ""
},

// ═══════════════════════════════════════════════════════════════
// 2. НЕСКОЛЬКО ПОДПИСОК — переключатель над главной кнопкой, у каждой подписки свои ссылки и счётчики
// ═══════════════════════════════════════════════════════════════
"subscriptions": {
  // false — переключателя нет, используется одна подписка из раздела «Основное»
  "enabled": true,
  // Показывать кнопки-переключатель. Если подписка одна, он скрыт в любом случае
  "showSwitcher": true,
  // Список подписок. Выбор запоминается в браузере.
  // id — короткий код, name — подпись на кнопке,
  // allUrl / allClashUrl — ссылки (универсальная и Clash),
  // configCount — число конфигов, если автоподсчёт выключен или не сработал,
  // updatedAt — своё время обновления, например "2026-11-07T17:00:00Z" (пусто — общее из «Основное»),
  // counting — свои настройки автоподсчёта: source, mode, exclude, exceptionsUrl, enabled
  "list": [
    { "id": "main", "name": "Основная", "allUrl": "https://example.com/sub/all", "allClashUrl": "https://example.com/sub/all.yaml", "configCount": 158, "updatedAt": "", "counting": { "source": "configs.txt" } },
    { "id": "reserve", "name": "Резерв", "allUrl": "https://example.com/sub/reserve", "allClashUrl": "https://example.com/sub/reserve.yaml", "configCount": 40, "updatedAt": "", "counting": { "source": "configs-reserve.txt" } },
    { "id": "mobile", "name": "Для мобильных", "allUrl": "https://example.com/sub/mobile", "allClashUrl": "https://example.com/sub/mobile.yaml", "configCount": 64, "updatedAt": "", "counting": { "enabled": false } },
  ],
},

// ═══════════════════════════════════════════════════════════════
// 3. ПРИЛОЖЕНИЯ — карточки клиентов в блоке «Приложения»
// name — название, platform — подпись под названием, url — ссылка «Скачать»,
// note — метка на карточке (необязательно),
// os — для каких систем: android, ios, windows, macos, linux,
// recommended — показывать первым в блоке «Для вашего устройства»
// ═══════════════════════════════════════════════════════════════
"apps": [
    {"name": "Happ", "platform": "Android, iOS, Windows, macOS", "url": "https://example.com/apps/happ", "note": "Рекомендуем", "os": ["android", "ios", "windows", "macos"], "recommended": true},
    {"name": "v2rayNG", "platform": "Android", "url": "https://example.com/apps/v2rayng", "note": "", "os": ["android"], "recommended": false},
    {"name": "Streisand", "platform": "iOS", "url": "https://example.com/apps/streisand", "note": "", "os": ["ios"], "recommended": false},
    {"name": "Hiddify", "platform": "Windows, macOS, Linux", "url": "https://example.com/apps/hiddify", "note": "", "os": ["windows", "macos", "linux"], "recommended": false},
    {"name": "Clash Verge Rev", "platform": "Windows, macOS, Linux", "url": "https://example.com/apps/clash-verge", "note": "Для Clash-режима", "os": ["windows", "macos", "linux"], "recommended": false},
],

// ╔═════════════════ ЧАСТЬ Б. ФУНКЦИИ ═════════════════╗

// ═══════════════════════════════════════════════════════════════
// 4. ОКНО «ПРИЛОЖЕНИЯ» — приложения открываются во всплывающем окне
// ═══════════════════════════════════════════════════════════════
"appsWindow": {
  // false — кнопка «Приложения» и окно не показываются
  "enabled": true,
  // Подпись кнопки под главной кнопкой
  "buttonLabel": "Приложения",
  // Заголовок окна
  "title": "Приложения",
},

// ═══════════════════════════════════════════════════════════════
// 5. СТАТУС ONLINE — бейдж под подзаголовком
// ═══════════════════════════════════════════════════════════════
"status": {
  // Показывать бейдж
  "enabled": true,
  // Сколько минут данные считаются свежими
  "freshMinutes": 120,
  // Подписи: online — если свежо, stale — если давно не обновлялось
  "labels": { "online": "Online", "stale": "Давно не обновлялось" },
},

// ═══════════════════════════════════════════════════════════════
// 6. ЗАКРЕПЛЁННОЕ СООБЩЕНИЕ — плашка над заголовком
// ═══════════════════════════════════════════════════════════════
"notice": {
  // Показывать плашку (нужен ещё непустой text)
  "enabled": false,
  // Идентификатор. Поменяйте, чтобы показать плашку заново тем, кто её закрыл
  "id": "n1",
  // Вид: "info" — обычная, "warning" — предупреждение
  "type": "info",
  // Текст сообщения
  "text": "Сервера обновляются каждый день вечером.",
  // Ссылка в конце сообщения (необязательно): подпись и адрес
  "linkText": "",
  "linkUrl": "",
  // Можно ли закрыть крестиком
  "dismissible": true,
  // Скрыть автоматически после даты, например "2026-12-01T00:00:00Z". Пусто — без срока
  "until": "",
},

// ═══════════════════════════════════════════════════════════════
// 7. ОПРЕДЕЛЕНИЕ СИСТЕМЫ — блок «Для вашего устройства»
// ═══════════════════════════════════════════════════════════════
"osDetect": {
  // Включить определение системы по браузеру
  "enabled": true,
  // Заголовок блока, {os} заменится на название системы
  "title": "Для вашего устройства: {os}",
  // Ставить подходящие приложения выше остальных
  "sortApps": true,
  // Для проверки: принудительно задать систему ("android", "ios", "windows", "macos", "linux"). Пусто — определять само
  "force": "",
},

// ═══════════════════════════════════════════════════════════════
// 8. «ДОБАВИТЬ В КЛИЕНТ» — кнопка с выбором приложения
// ═══════════════════════════════════════════════════════════════
"deeplinks": {
  // Показывать кнопку
  "enabled": true,
  // Текст кнопки и заголовок окна выбора
  "buttonLabel": "Добавить в клиент",
  "title": "Выберите клиент",
  // Список клиентов. scheme — шаблон ссылки: {url} — подписка как есть,
  // {urlEnc} — подписка в закодированном виде. clashScheme — отдельный шаблон для Clash-режима
  "clients": [
      {"name": "Happ", "note": "Android, iOS, Windows, macOS", "os": ["android", "ios", "windows", "macos"], "scheme": "happ://add/{url}"},
      {"name": "v2rayNG", "note": "Android", "os": ["android"], "scheme": "v2rayng://install-sub?url={urlEnc}"},
      {"name": "Streisand", "note": "iOS", "os": ["ios"], "scheme": "streisand://import/{url}"},
      {"name": "Hiddify", "note": "Windows, macOS, Linux", "os": ["windows", "macos", "linux"], "scheme": "hiddify://import/{url}"},
      {"name": "Clash Verge", "note": "Windows, macOS, Linux", "os": ["windows", "macos", "linux"], "scheme": "clash://install-config?url={urlEnc}"},
  ],
},

// ═══════════════════════════════════════════════════════════════
// 9. «СООБЩИТЬ О ПРОБЛЕМЕ» — кнопка внизу страницы
// ═══════════════════════════════════════════════════════════════
"report": {
  // Показывать кнопку
  "enabled": true,
  // Подпись кнопки
  "label": "Сообщить о проблеме",
  // Куда вести. {text} — готовое сообщение. Подойдёт и "mailto:адрес?subject=Проблема&body={text}"
  "url": "https://t.me/your_username?text={text}",
  // Текст сообщения. Подставляются: {format} — формат подписки, {device} — система, {updated} — время обновления
  "template": "Не работает подписка.\nФормат: {format}\nУстройство: {device}\nОбновлено: {updated}",
},

// ═══════════════════════════════════════════════════════════════
// 10. АВТОПОДСЧЁТ КОНФИГОВ — считает строки в отдельном файле и учитывает исключения
// ═══════════════════════════════════════════════════════════════
"counting": {
  // true — страница сама считает конфиги в файле. false — показывается configCount из «Основное».
  // Если файл не загрузился или в нём нет подходящих строк, остаётся configCount.
  "enabled": true,
  // Файл, в котором считаются строки (рядом с сайтом или прямая ссылка, например raw GitHub).
  // Пусто — берётся allUrl. Обычный текст или base64. Строки, начинающиеся с # или //, пропускаются.
  "source": "configs.txt",
  // Что считать: "uri" — только строки-конфиги вида vless://, trojan:// и т.п.; "lines" — все непустые строки
  "mode": "uri",
  // Исключения: строка не считается, если содержит любой из этих фрагментов (регистр не важен)
  "exclude": ["expired", "#off"],
  // Файл исключений: по одному фрагменту в строке, комментарии начинаются с //. Пусто — файл не нужен
  "exceptionsUrl": "exceptions.txt",
  // Сколько минут браузер помнит результат
  "cacheMinutes": 10,
},

// ═══════════════════════════════════════════════════════════════
// 11. ЭФФЕКТЫ — анимации нажатий
// ═══════════════════════════════════════════════════════════════
"effects": {
  // Круговая волна от места нажатия
  "ripple": true,
  // «Пружинящее» нажатие кнопок
  "spring": true,
},

}
